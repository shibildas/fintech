{
  "name": "fintech-infrastructure-stack",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Payments & Fintech Infrastructure — 4-Project Stack (Switch, Gateway, Consumer App + Risk, Mandates & Subscriptions)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "scripts": {
    "start": "node scripts/orchestrate.ts",
    "dev": "node --watch scripts/orchestrate.ts",
    "start:p1": "node scripts/orchestrate.ts --only=p1",
    "start:p2": "node scripts/orchestrate.ts --only=p2",
    "start:p3": "node scripts/orchestrate.ts --only=p3",
    "start:p4": "node scripts/orchestrate.ts --only=p4",
    "test": "node --test packages/core/test/*.test.ts projects/project1-switch/test/*.test.ts projects/project2-gateway/test/*.test.ts projects/project3-consumer-app/test/*.test.ts projects/project4-mandates/test/*.test.ts",
    "test:core": "node --test packages/core/test/*.test.ts",
    "test:p1": "node --test projects/project1-switch/test/*.test.ts",
    "test:p2": "node --test projects/project2-gateway/test/*.test.ts",
    "test:p3": "node --test projects/project3-consumer-app/test/*.test.ts",
    "test:p4": "node --test projects/project4-mandates/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reset:data": "rm -rf .data"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
