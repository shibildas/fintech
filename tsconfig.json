{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@fintech/core": ["./packages/core/src/index.ts"],
      "@fintech/project1-switch": ["./projects/project1-switch/src/index.ts"],
      "@fintech/project2-gateway": ["./projects/project2-gateway/src/index.ts"],
      "@fintech/project3-consumer-app": ["./projects/project3-consumer-app/src/index.ts"],
      "@fintech/project4-mandates": ["./projects/project4-mandates/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "projects/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", ".data"]
}
